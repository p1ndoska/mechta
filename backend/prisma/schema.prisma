generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

model Admin {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  passwordHash String
  role         AdminRole      @default(EDITOR)
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  token     String   @id
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

// Карточки номеров в блоке «Часто выбирают», добавляются через панель администратора
model Room {
  id          Int      @id @default(autoincrement())
  // Название и описание на русском, английском и белорусском
  titleRu       String
  titleEn       String   @default("")
  titleBe       String   @default("")
  descriptionRu String   @default("")
  descriptionEn String   @default("")
  descriptionBe String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  priceFrom   Boolean  @default(false)
  // Удобства номера: [{ ru, en, be }]
  amenities   Json     @default("[]")
  sortOrder   Int      @default(0)
  photo       Bytes?
  photoType   String?
  photos      RoomPhoto[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Дополнительные фото на странице номера
model RoomPhoto {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  data      Bytes
  type      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([roomId])
}

// Надписи на сайте, изменённые в панели администратора
model SiteText {
  key       String   @id
  ru        String
  en        String   @default("")
  be        String   @default("")
  updatedAt DateTime @updatedAt
}

// Карточки блока «Скидки»
model Discount {
  id        Int      @id @default(autoincrement())
  value     String
  textRu    String
  textEn    String   @default("")
  textBe    String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
