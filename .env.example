POSTGRES_USER=mechta
POSTGRES_PASSWORD=mechta
POSTGRES_DB=mechta
# false — если npm в Docker падает с "self-signed certificate"
NPM_STRICT_SSL=true

# Панель администратора /administrator: с каких IP пускать (адреса или подсети через запятую).
# 172.16.0.0/12 и 192.168.65.0/24 — адреса Docker, под ними приходят запросы с этого компьютера.
ADMIN_ALLOWED_IPS=127.0.0.1,::1,172.16.0.0/12,192.168.65.0/24
# Админ по умолчанию: создаётся при первом запуске, если в базе ещё нет админов
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
